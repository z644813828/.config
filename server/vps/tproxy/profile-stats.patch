+func TestProfileSessionsSnapshot(t *testing.T) {
+	configuration := testConfig("127.0.0.1:1")
+	manager := NewManager(configuration, [32]byte{1})
+	defer manager.Shutdown()
+	profile := &configuration.Profiles[0]
+	if got, ok := manager.ProfileSessions()[profile.Name]; !ok || got != 0 {
+		t.Fatal("idle profile missing or not zero")
+	}
+	token, err := manager.IssueBootstrap(profile, "198.51.100.11")
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := manager.Create(token, "198.51.100.11", frame.Encode(frame.Hello, 0, []byte{1}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot := manager.ProfileSessions()
+	if snapshot[profile.Name] != 1 {
+		t.Fatal("live session not counted")
+	}
+	snapshot[profile.Name] = 999
+	if manager.ProfileSessions()[profile.Name] != 1 {
+		t.Fatal("snapshot aliases state")
+	}
+	value.Session.Close()
+	waitFor(t, func() bool { return manager.ProfileSessions()[profile.Name] == 0 })
+}
