+// ProfileSessions reports authenticated live relay sessions, including idle profiles.
+// It returns a snapshot, never tokens, secrets or client addresses.
+func (m *Manager) ProfileSessions() map[string]int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	result := make(map[string]int, len(m.config.Profiles))
+	for _, profile := range m.config.Profiles {
+		result[profile.Name] = m.sessionsPerProfile[profile.Name]
+	}
+	return result
+}
