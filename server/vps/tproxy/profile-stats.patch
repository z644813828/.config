+func TestProfileStatsAdminOnly(t *testing.T) {
+	application, _ := newTestServer(t, "127.0.0.1:1")
+	admin := httptest.NewRecorder()
+	application.AdminHandler().ServeHTTP(admin, httptest.NewRequest(http.MethodGet, "http://localhost/profile-stats", nil))
+	if admin.Code != http.StatusOK || !strings.Contains(admin.Header().Get("Content-Type"), "application/json") {
