server {
    listen 8880 ssl;
    listen [::]:8880 ssl;
    server_name server.example.invalid;

    ssl_certificate /etc/letsencrypt/live/server.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server.example.invalid/privkey.pem;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 8880;
        proxy_request_buffering off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        proxy_redirect off;
    }
}
