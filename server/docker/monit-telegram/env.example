TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Set your numeric Telegram user ID to enable private-chat commands.
# TELEGRAM_ALLOWED_USER_ID=USER_ID
# MONIT_URL=https://127.0.0.1:2812
# MONIT_USERNAME=admin
# MONIT_PASSWORD=replace_with_monit_password
# Only for a self-signed certificate on the local Monit endpoint:
# MONIT_TLS_VERIFY=false
# HTTPS_PROXY=http://proxy-host:3128
# NO_PROXY=localhost,127.0.0.1

# Also forward new notifications to the existing local SMTP server on port 25.
MAIL_RELAY_ENABLED=true
