(version 1)
(deny default)
(allow process-exec (subpath "/Applications/Ollama.app/Contents/Resources"))
(allow process-fork)
(allow sysctl-read)
(allow iokit-open (iokit-user-client-class "AGXDeviceUserClient"))
(allow mach-lookup (global-name "com.apple.MTLCompilerService"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/Applications/Ollama.app"))
(allow file-read-metadata (literal "/Users"))
(allow file-read* (literal (param "HOME_DIR")))
(allow file-read* (literal (param "OLLAMA_DIR")))
(allow file-read* (subpath (param "MODELS")))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))

(allow file-read* (literal "/"))
